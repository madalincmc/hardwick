# Sanity project — from manage.sanity.io after `npx sanity init` (see README).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Shared secret configured on the Sanity webhook (manage.sanity.io -> API -> Webhooks)
# that hits /api/revalidate on publish. Required in Vercel; any random string works.
SANITY_REVALIDATE_SECRET=

# Editor-permission token (manage.sanity.io -> API -> Tokens), used only by
# scripts/migrate-to-sanity.ts. Local use only — never set this in Vercel.
SANITY_MIGRATION_TOKEN=

# Production/preview site URL, used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=

# Resend (resend.com) API key used by app/api/contact/route.ts to send contact-form
# submissions server-side. Required in Vercel for the contact form to work.
RESEND_API_KEY=

# Sender address for contact-form emails. Must be on a domain verified in Resend
# (Resend rejects sends from unverified domains) — resend.com/domains. For local
# testing without a verified domain, Resend's shared sandbox address works:
# onboarding@resend.dev
CONTACT_FROM_EMAIL=

# Recipient address for contact-form submissions. Optional — defaults to the
# `email` set in lib/site.ts if unset.
CONTACT_TO_EMAIL=
